{
  "name": "zhizhang",
  "private": true,
  "version": "1.0.0",
  "description": "织章 · 本地优先的小说创作工作台",
  "author": "织章",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node server/index.js",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "icon": "node scripts/make-icon.mjs",
    "electron": "electron .",
    "electron:build": "npm run build && electron-builder --win",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:assets": "node scripts/make-android-assets.mjs && node scripts/make-android-adaptive-icon.mjs",
    "android:build": "npm run build && cap sync android && npm run android:assets && node scripts/build-android.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-underline": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.0.17",
    "typescript": "^5.7.2",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.zhizhang.studio",
    "productName": "织章",
    "copyright": "织章",
    "asar": true,
    "npmRebuild": false,
    "compression": "maximum",
    "directories": {
      "output": "E:/ZhizhangBuild/electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      "LICENSE"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "织章",
      "artifactName": "织章-${version}-安装包.${ext}",
      "uninstallDisplayName": "织章 · 小说创作工作台"
    },
    "portable": {
      "artifactName": "织章-${version}-便携版.${ext}"
    }
  }
}
